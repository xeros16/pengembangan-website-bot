# Salin file ini menjadi .env lalu isi konfigurasi lokal.
# Jangan pernah membagikan .env atau memasukkannya ke ZIP distribusi.

# Prefix perintah WhatsApp
PREFIX=.

# MongoDB lokal; ganti dengan URI database milik sendiri.
MONGO_URI=mongodb://127.0.0.1:27017/pir_visuals_local

# Kredensial Designer Studio website (gunakan password unik minimal 16 karakter).
DASHBOARD_USER=owner
DASHBOARD_PASSWORD=replace-with-a-long-unique-password

# JID Owner, pisahkan beberapa nilai dengan koma.
# Contoh format: 628xxxxxxxxxx@s.whatsapp.net
OWNER_JIDS=

# Direktori sesi dan file lokal (opsional; gunakan lokasi privat).
AUTH_DIR=auth_info_baileys
TEMP_DIR=temp
BACKUP_DIR=backups
PORTFOLIO_UPLOAD_DIR=portfolio_uploads

# Pengaturan opsional
NODE_ENV=development
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
# Default false: WhatsApp auth credentials are sensitive. Enable only with a private backup location.
BACKUP_INCLUDE_LOCAL_STATE=false
# Health endpoint is loopback-only; use a local process monitor on this port.
BOT_HEALTH_HOST=127.0.0.1
BOT_HEALTH_PORT=3091
BOT_SUBSCRIPTIONS_FILE=
DESIGN_COMMUNITY_GROUPS=
WELCOME_IMAGE=
GAME_MENU_IMAGE=
GAME_HELP_IMAGE=
GAME_BANTUAN_IMAGE=


# PIR Visuals website shares the SAME MongoDB database as the WhatsApp bot.
# Run the website with: npm run website
BOT_DATA_ROOT=.
PORTFOLIO_WEB_HOST=127.0.0.1
PORTFOLIO_WEB_PORT=3010
PORTFOLIO_PUBLIC_BASE_URL=http://127.0.0.1:3010
# Keep the same PORTFOLIO_UPLOAD_DIR as the bot. Portfolio image uploads are website-only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# PIR Visuals Customer Support (optional)
SUPPORT_EMAIL=help@example.com
SUPPORT_WHATSAPP=6281234567890
SUPPORT_HOURS=Senin-Jumat, 09.00-17.00 WIB

# Canonical public website origin (used by robots.txt and sitemap.xml)
SITE_URL=http://127.0.0.1:3010
